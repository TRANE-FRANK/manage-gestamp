generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Company {
    ORM
    GP2
}

enum UserRole {
    ADMIN
    IT
    SECURITY
}

enum EquipmentType {
    LAPTOP
    DESKTOP
    SMARTPHONE
    TABLET
    RADIO
    PRINTER
}

enum EquipmentStatus {
    ASSIGNED
    AVAILABLE
    STORAGE
    MAINTENANCE
    RETIRED
}

enum PermitStatus {
    ACTIVE
    EXPIRED
    CANCELLED
}

enum ScanResult {
    ALLOWED
    DENIED
}

enum ScanReason {
    ALLOWED
    INVALID_ASSET_TAG
    EQUIPMENT_NOT_FOUND
    NO_PERMIT
    CANCELLED
    EXPIRED
    NOT_STARTED
    NOT_ACTIVE
}

enum EquipmentOwnership {
    OWNED
    RENTED
}

enum AuditOutcome {
    SUCCESS
    FAILURE
}

model User {
    id           Int      @id @default(autoincrement())
    username     String   @unique
    passwordHash String
    firstName    String?
    lastName     String?
    role         UserRole
    isActive     Boolean  @default(true)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
}

model AuditEvent {
    id                    Int          @id @default(autoincrement())
    occurredAt            DateTime     @default(now())
    actorUserIdSnapshot   Int?
    actorUsernameSnapshot String?
    actorRoleSnapshot     UserRole?
    action                String
    entityType            String
    entityId              String
    outcome               AuditOutcome
    source                String
    before                Json?
    after                 Json?
    reason                String?

    @@index([occurredAt])
    @@index([actorUserIdSnapshot, occurredAt])
    @@index([entityType, entityId, occurredAt])
    @@index([action, occurredAt])
}

model Employee {
    id        Int    @id @default(autoincrement())
    sapNumber String @unique
    firstName String
    lastName  String

    department    String?
    departmentId  Int?
    departmentRef Department? @relation("EmployeeDepartment", fields: [departmentId, company], references: [id, company], onDelete: Restrict)

    position    String?
    company     Company
    photoPath   String?
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    assignments Assignment[]
    permits     Permit[]
}

model Equipment {
    id              Int             @id @default(autoincrement())
    assetTag        String?         @unique
    barcode         String?         @unique
    type            EquipmentType?
    inventoryNumber String?         @unique
    serialNumber    String?         @unique
    brand           String?
    model           String?
    company         Company
    status          EquipmentStatus

    responsibleDepartmentId Int?
    responsibleDepartment   Department? @relation("EquipmentResponsibleDepartment", fields: [responsibleDepartmentId, company], references: [id, company], onDelete: Restrict)

    locationId Int?
    location   Location? @relation(fields: [locationId, company], references: [id, company], onDelete: Restrict)

    createdAt         DateTime           @default(now())
    updatedAt         DateTime           @updatedAt
    assignments       Assignment[]
    permits           Permit[]
    maintenances      Maintenance[]
    ownership         EquipmentOwnership @default(OWNED)
    warrantyExpiresAt DateTime?
}

model Assignment {
    id                 Int       @id @default(autoincrement())
    employeeId         Int
    equipmentId        Int
    assignedAt         DateTime
    returnedAt         DateTime?
    cancelledAt        DateTime?
    cancellationReason String?
    replacementReason  String?
    generatedPdfPath   String?
    signedPdfPath      String?
    employee           Employee  @relation(fields: [employeeId], references: [id])
    equipment          Equipment @relation(fields: [equipmentId], references: [id])
    createdAt          DateTime  @default(now())

    @@index([employeeId])
    @@index([equipmentId])
}

model Permit {
    id             Int          @id @default(autoincrement())
    folio          String       @unique
    employeeId     Int
    equipmentId    Int
    startDate      DateTime
    expirationDate DateTime
    status         PermitStatus

    generatedPdfPath String?
    signedPdfPath    String?

    departureAuthorized          Boolean   @default(false)
    departureAuthorizedAt        DateTime?
    departureAuthorizationReason String?

    cancelledAt        DateTime?
    cancellationReason String?

    employee  Employee  @relation(fields: [employeeId], references: [id])
    equipment Equipment @relation(fields: [equipmentId], references: [id])
    scanLogs  ScanLog[]
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@index([employeeId])
    @@index([equipmentId])
    @@index([status])
}

model ScanLog {
    id        Int        @id @default(autoincrement())
    permitId  Int?
    scannedAt DateTime   @default(now())
    assetTag  String?
    result    ScanResult
    reason    ScanReason
    notes     String?
    permit    Permit?    @relation(fields: [permitId], references: [id])

    @@index([permitId])
    @@index([scannedAt])
    @@index([result])
}

model MaintenanceBatch {
    id           Int           @id @default(autoincrement())
    createdAt    DateTime      @default(now())
    maintenances Maintenance[]
}

model Maintenance {
    id               Int               @id @default(autoincrement())
    equipmentId      Int
    maintenanceDate  DateTime          @db.Date
    batchId          Int?
    provider         String?
    folio            String?
    generatedPdfPath String?
    signedPdfPath    String?
    notes            String?
    equipment        Equipment         @relation(fields: [equipmentId], references: [id])
    batch            MaintenanceBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
    createdAt        DateTime          @default(now())

    @@unique([equipmentId, maintenanceDate])
    @@index([equipmentId])
    @@index([maintenanceDate])
    @@index([batchId])
}

model Department {
    id       Int     @id @default(autoincrement())
    name     String
    company  Company
    isActive Boolean @default(true)

    employees            Employee[]  @relation("EmployeeDepartment")
    responsibleEquipment Equipment[] @relation("EquipmentResponsibleDepartment")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([id, company])
    @@unique([company, name])
    @@index([company, isActive])
}

model Location {
    id       Int     @id @default(autoincrement())
    name     String
    company  Company @default(GP2)
    parentId Int?

    parent    Location?   @relation("LocationHierarchy", fields: [parentId, company], references: [id, company], onDelete: Restrict)
    children  Location[]  @relation("LocationHierarchy")
    equipment Equipment[]

    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([id, company])
    @@unique([company, parentId, name])
    @@index([company, parentId])
}
