# Local placeholders only. Put real values in an untracked .env file or the
# deployment secret manager. Do not use these example credentials.
DATABASE_URL="postgresql://example_user:example_password@localhost:5432/example_db?schema=public"

# Future Auth.js configuration (Auth.js is not installed/configured yet).
# Replace this placeholder with a generated random secret in the deployment
# secret manager before enabling authentication.
AUTH_SECRET=replace-before-enabling-auth-with-a-random-secret

# Optional canonical public origin, if required by the deployment.
# AUTH_URL=https://manage.example.invalid

# Set only behind a trusted reverse proxy that overwrites forwarded host/proto.
# AUTH_TRUST_HOST=true
